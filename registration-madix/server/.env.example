NODE_ENV=production
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=https://your-domain-or-ip

DATABASE_URL=postgres://madix:madix@db:5432/madix
DATABASE_SSL=false
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=90d

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/data/recordings
MAX_UPLOAD_BYTES=4294967296

# Optional S3-compatible object storage (set STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Live view (WebRTC). TURN relays traffic when devices are behind NAT.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL=3600

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=madix
POSTGRES_PASSWORD=madix
POSTGRES_DB=madix
